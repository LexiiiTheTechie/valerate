# Normalise line endings across platforms.
* text=auto

# Windows scripts must keep CRLF so cmd.exe parses them reliably.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF.
*.sh text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.pfx binary
*.zip binary
*.sqlite3 binary
