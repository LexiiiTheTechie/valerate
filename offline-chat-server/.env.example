# ==============================================================================
# OFFLINE LAN CHAT SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace every CHANGE_ME value. start.sh generates
# random secrets automatically on first run.
LAN_IP=CHANGE_ME_LAN_IP
SERVER_NAME=CHANGE_ME_LAN_IP

# PostgreSQL Configuration
POSTGRES_DB=synapse
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Synapse Security Secrets (generate with: openssl rand -hex 32)
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_64_HEX_CHARS
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
SYNAPSE_FORM_SECRET=CHANGE_ME_64_HEX_CHARS

# WebRTC Coturn Shared Secret (Must match between Coturn and Synapse)
TURN_SHARED_SECRET=CHANGE_ME_64_HEX_CHARS
